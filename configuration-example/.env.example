# Copy to the repository root as `.env` and edit. `.env` is git-ignored.
# Every value here has a working default except AEA_CORPUS_ROOT.

# ---------------------------------------------------------------------------
# Corpus (read-only) and derived data
# ---------------------------------------------------------------------------
# Absolute path to the unpacked Ashen Era Archive. The archive is never written to.
AEA_CORPUS_ROOT=/absolute/path/to/Ashen_Era_Archive

# Where the index, extracted assets and caches are written. Safe to delete.
AEA_DATA_DIR=./data
AEA_DB_PATH=./data/archive.sqlite3
AEA_ASSETS_DIR=./data/assets
AEA_CACHE_DIR=./data/cache

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
AEA_CHUNK_TARGET_CHARS=1200
AEA_CHUNK_OVERLAP_CHARS=180

# OCR requires the `tesseract` binary on PATH (macOS: brew install tesseract).
# Set to 0 to skip it: ingestion still succeeds, but the 17 scanned PDFs and the
# figure plates contribute captions only. See docs/limitations.md.
AEA_OCR_ENABLED=1

# ---------------------------------------------------------------------------
# Retrieval fusion weights (must be defensible against the evaluation set,
# not hand-tuned to individual questions)
# ---------------------------------------------------------------------------
AEA_W_BM25=0.35
AEA_W_VECTOR=0.45
AEA_W_ENTITY=0.10
AEA_W_SOURCE=0.10

# ---------------------------------------------------------------------------
# Investigation budget — the loop is bounded and must always be able to say
# which limit stopped it.
# ---------------------------------------------------------------------------
AEA_MAX_ITERATIONS=6
AEA_MAX_QUERIES=24
AEA_MAX_GRAPH_HOPS=3
AEA_STALE_ROUNDS=2
AEA_MAX_SECONDS=120

# ---------------------------------------------------------------------------
# Models — OpenAI-compatible gateway. Leave the keys empty to run the
# deterministic layers (ingestion, keyword search, graph, facts) without any
# network access at all.
# ---------------------------------------------------------------------------
AEA_LLM_BASE_URL=https://openrouter.ai/api/v1
AEA_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
AEA_LLM_API_KEY=

AEA_EMBEDDING_MODEL=voyage-4-lite
AEA_EMBEDDING_API_KEY=
